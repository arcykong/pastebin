<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View Paste</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <h1>View Paste</h1>
    <textarea id="paste-text" hidden readonly>
<%= text %></textarea>
    <pre id="paste-display" class="paste-display"></pre>
    <button type="button" onclick="copyToClipboard()">Copy URL</button>
    <button type="button" onclick="copyText()">Copy Text</button>
    <button type="button" onclick="window.location.href='/'">New Paste</button>

    <div id="qr-code-container" class="qr-code">
      <h3>Scan QR Code</h3>
      <div id="qr-code"></div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/qrcode-generator/qrcode.js"></script>
  <script>
    // Build links using DOM nodes so paste content remains text.
    const pasteText = document.getElementById('paste-text').value;
    const pasteDisplay = document.getElementById('paste-display');
    const urlPattern = /https?:\/\/[^\s<>"']+/gi;
    let lastIndex = 0;
    for (const match of pasteText.matchAll(urlPattern)) {
      let url = match[0].replace(/[.,!?;:)\]}]+$/, '');
      pasteDisplay.appendChild(document.createTextNode(pasteText.slice(lastIndex, match.index)));
      const link = document.createElement('a');
      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = url;
      pasteDisplay.appendChild(link);
      lastIndex = match.index + url.length;
    }
    pasteDisplay.appendChild(document.createTextNode(pasteText.slice(lastIndex)));

    // Generate QR Code
    try {
      const typeNumber = 4;
      const errorCorrectionLevel = 'L';
      const qr = qrcode(typeNumber, errorCorrectionLevel);
      qr.addData(window.location.href);
      qr.make();
      document.getElementById('qr-code').innerHTML = qr.createImgTag(4);
    } catch (e) {
      console.error("QR Code generation failed:", e);
      document.getElementById('qr-code-container').style.display = 'none';
    }

    // Copy URL to clipboard
    function copyToClipboard() {
      const url = window.location.href;
      navigator.clipboard.writeText(url).then(() => {
        alert('URL copied to clipboard!');
      }, () => {
        alert('Failed to copy URL.');
      });
    }

    function copyText() {
      const text = document.getElementById('paste-text').value;
      navigator.clipboard.writeText(text).then(() => {
        alert('Text copied to clipboard!');
      }, () => {
        alert('Failed to copy text.');
      });
    }
  </script>
</body>
</html>
